# Python virtualenv layout (auto-creates venv if not exists)
layout_python() {
    local python=${1:-python3}

    unset PYTHONHOME

    if [[ -n "${VIRTUAL_ENV:-}" ]]; then
        local old_venv=$VIRTUAL_ENV
        unset VIRTUAL_ENV
    fi

    if [[ -d ".venv" ]]; then
        VIRTUAL_ENV="$(pwd)/.venv"
    elif [[ -d "venv" ]]; then
        VIRTUAL_ENV="$(pwd)/venv"
    else
        log_status "Creating virtualenv..."
        $python -m venv .venv
        VIRTUAL_ENV="$(pwd)/.venv"
    fi

    export VIRTUAL_ENV
    PATH_add "$VIRTUAL_ENV/bin"
}

# Alias for layout_python
layout_virtualenv() {
    layout_python "$@"
}

# Poetry layout
layout_poetry() {
    if [[ ! -f pyproject.toml ]]; then
        log_error "No pyproject.toml found"
        return 1
    fi

    VIRTUAL_ENV=$(poetry env info --path 2>/dev/null)

    if [[ -z "$VIRTUAL_ENV" || ! -d "$VIRTUAL_ENV" ]]; then
        log_status "Creating poetry virtualenv..."
        poetry install
        VIRTUAL_ENV=$(poetry env info --path)
    fi

    export VIRTUAL_ENV
    PATH_add "$VIRTUAL_ENV/bin"
}

# Node.js layout (uses local node_modules/.bin)
layout_node() {
    PATH_add "node_modules/.bin"

    if [[ -f ".nvmrc" ]]; then
        if command -v mise &>/dev/null; then
            mise use node
        elif command -v nvm &>/dev/null; then
            nvm use
        fi
    fi
}

# Go layout
layout_go() {
    export GOPATH="$(pwd)/.go"
    PATH_add ".go/bin"
    PATH_add "bin"
}

# Rust layout
layout_rust() {
    PATH_add "target/debug"
    PATH_add "target/release"

    if [[ -f "rust-toolchain" || -f "rust-toolchain.toml" ]]; then
        log_status "Using rust-toolchain"
    fi
}

# Ruby layout (bundler)
layout_ruby() {
    if [[ -f "Gemfile" ]]; then
        export BUNDLE_BIN="$(pwd)/.bundle/bin"
        PATH_add ".bundle/bin"
    fi
}

# ══════════════════════════════════════════════════════════════════════════════
#                              Utility Functions
# ══════════════════════════════════════════════════════════════════════════════

# Load .env file if it exists
dotenv() {
    local envfile="${1:-.env}"
    if [[ -f "$envfile" ]]; then
        log_status "Loading $envfile"
        set -a
        source "$envfile"
        set +a
    fi
}

# Load .env.local if it exists (for local overrides)
dotenv_if_exists() {
    local envfile="${1:-.env}"
    if [[ -f "$envfile" ]]; then
        dotenv "$envfile"
    fi
}

# Source a file if it exists
source_if_exists() {
    if [[ -f "$1" ]]; then
        source "$1"
    fi
}

# Add to PATH only if directory exists
path_add_if_exists() {
    if [[ -d "$1" ]]; then
        PATH_add "$1"
    fi
}

# Use mise to manage tool versions
use_mise() {
    if command -v mise &>/dev/null; then
        eval "$(mise hook-env -s zsh)"
    fi
}

# Use asdf to manage tool versions
use_asdf() {
    if command -v asdf &>/dev/null; then
        source "$(brew --prefix asdf)/libexec/asdf.sh"
    fi
}

# AWS profile switcher
use_aws() {
    local profile="${1:-default}"
    export AWS_PROFILE="$profile"
    log_status "Using AWS profile: $profile"
}

# Kubernetes context switcher
use_kubectl() {
    local context="${1:-}"
    if [[ -n "$context" ]]; then
        export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"
        kubectl config use-context "$context" 2>/dev/null
        log_status "Using kubectl context: $context"
    fi
}

# Docker context switcher
use_docker() {
    local context="${1:-default}"
    export DOCKER_CONTEXT="$context"
    log_status "Using Docker context: $context"
}

# ══════════════════════════════════════════════════════════════════════════════
#                              Project Templates
# ══════════════════════════════════════════════════════════════════════════════

# Standard Python project
use_python_project() {
    layout_python python3
    dotenv_if_exists .env
    dotenv_if_exists .env.local
}

# Standard Node.js project
use_node_project() {
    layout_node
    dotenv_if_exists .env
    dotenv_if_exists .env.local
}

# Standard Go project
use_go_project() {
    layout_go
    dotenv_if_exists .env
}

