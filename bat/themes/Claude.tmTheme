        <!-- YAML Key: Teal -->
        <dict>
            <key>name</key>
            <string>YAML Key</string>
            <key>scope</key>
            <string>entity.name.tag.yaml</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#8ea4a2</string>
            </dict>
        </dict>

        <!-- Shell Variable: Coral -->
        <dict>
            <key>name</key>
            <string>Shell Variable</string>
            <key>scope</key>
            <string>variable.other.normal.shell, variable.other.special.shell</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#d4a27f</string>
            </dict>
